{
  "name": "forgeloop-studio",
  "version": "0.1.0-rc.6",
  "description": "A real-time visual interface for the ForgeLoop engineering protocol",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && wait-on http://localhost:5173 && electron .",
    "build": "npm run clean && npm run build:renderer && npm run build:electron && node scripts/assert-build.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-electron.mjs",
    "build:preload": "node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=none",
    "dependency:policy": "node scripts/dependency-policy.mjs",
    "docs:check": "node scripts/check-doc-conformance.mjs",
    "demo:generate": "node scripts/generate-demo-project.mjs",
    "demo:verify": "node scripts/verify-demo-project.mjs",
    "test:coverage": "vitest run --coverage",
    "test:release-contracts": "node --test scripts/__tests__/release-contracts.test.mjs scripts/__tests__/verify-release-assets.test.mjs scripts/__tests__/large-ledger-fixture.test.mjs scripts/__tests__/release-workflow.test.mjs scripts/__tests__/public-release-workflow.test.mjs scripts/__tests__/ui-version.test.mjs scripts/__tests__/version-lineage.test.mjs scripts/__tests__/sbom-normalize.test.mjs scripts/__tests__/demo-project.test.mjs",
    "verify:critical-coverage": "node scripts/verify-critical-coverage.mjs",
    "verify:full": "node scripts/verify-full.mjs",
    "benchmark:large-project": "node scripts/benchmark-large-project.mjs",
    "verify:performance": "node scripts/verify-performance-budget.mjs",
    "protocol:schemas:verify": "node scripts/verify-schema-provenance.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder",
    "verify:electron-fuses": "node scripts/verify-electron-fuses.mjs",
    "verify:release-matrix": "node scripts/assert-release-matrix.mjs",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "package:dir": "npm run build && electron-builder --dir",
    "test:packaged-smoke": "npm run package:dir && node scripts/packaged-smoke.mjs",
    "test:packaged-open-demo": "node scripts/packaged-open-demo.mjs",
    "test:electron-smoke": "npm run build && playwright test tests/e2e/electron-smoke.spec.ts"
  },
  "keywords": [
    "forgeloop",
    "electron",
    "visualizer",
    "engineering-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cassiomc1/forgeloop": "file:vendor/cassiomc1-forgeloop-1.5.0.tgz",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@xyflow/react": "^12.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.0",
    "lucide-react": "^0.447.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.47",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.8",
    "vitest": "4.1.11",
    "wait-on": "^9.1.0"
  },
  "build": {
    "afterPack": "scripts/after-pack-fuses.mjs",
    "appId": "com.forgeloop.studio",
    "productName": "ForgeLoop Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "schemas/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "demo",
        "to": "demo"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.25.9": true
  }
}
