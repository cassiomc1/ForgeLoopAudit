{
  "name": "forgeloop-audit",
  "version": "0.3.0-rc.2",
  "description": "Read-only engineering auditor for ForgeLoop projects",
  "main": "dist/server/cli.mjs",
  "bin": {
    "forgeloop-audit": "dist/server/cli.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run build:web && node dist/server/cli.mjs --demo",
    "build": "npm run build:web && node scripts/assert-web-build.mjs",
    "build:web": "npm run clean && npm run build:renderer && npm run build:server",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:renderer": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=none",
    "dependency:policy": "node scripts/dependency-policy.mjs",
    "verify:forgeloop-lineage": "node scripts/verify-forgeloop-vendor-lineage.mjs",
    "docs:check": "node scripts/check-doc-conformance.mjs && node scripts/check-readme-screenshots.mjs",
    "brand:check": "node scripts/check-brand-conformance.mjs",
    "screenshots:readme": "npm run build:web && node scripts/capture-readme-screenshots.mjs",
    "screenshots:readme:check": "npm run screenshots:check",
    "screenshots:check": "node scripts/check-readme-screenshots.mjs",
    "demo:generate": "node scripts/generate-demo-project.mjs",
    "demo:verify": "node scripts/verify-demo-project.mjs",
    "test:coverage": "vitest run --coverage",
    "test:release-contracts": "node --test scripts/__tests__/large-ledger-fixture.test.mjs scripts/__tests__/release-workflow.test.mjs scripts/__tests__/public-release-workflow.test.mjs scripts/__tests__/ui-version.test.mjs scripts/__tests__/version-lineage.test.mjs scripts/__tests__/sbom-normalize.test.mjs scripts/__tests__/demo-project.test.mjs scripts/__tests__/forgeloop-vendor-lineage.test.mjs scripts/__tests__/docs-conformance.test.mjs scripts/__tests__/brand-conformance.test.mjs",
    "verify:critical-coverage": "node scripts/verify-critical-coverage.mjs",
    "verify:full": "node scripts/verify-full.mjs",
    "benchmark:large-project": "node scripts/benchmark-large-project.mjs",
    "verify:performance": "node scripts/verify-performance-budget.mjs",
    "protocol:schemas:verify": "node scripts/verify-schema-provenance.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:web && playwright test",
    "package": "npm run build:web && npm pack --dry-run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run brand:check && npm run docs:check && npm run build",
    "test:web-smoke": "npm run build:web && playwright test tests/e2e/web-smoke.spec.ts"
  },
  "keywords": [
    "forgeloop",
    "audit",
    "engineering-audit",
    "evidence",
    "verification",
    "web",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cassiomc1/forgeloop": "file:vendor/cassiomc1-forgeloop-1.12.0-ea36276.tgz",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@xyflow/react": "^12.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.447.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.47",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
